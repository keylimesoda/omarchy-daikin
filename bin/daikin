#!/usr/bin/env python3
"""daikin — Linux controller for the Daikin BRP072A43 mini-split Wi-Fi adapter.

Port of the keylimesoda/DaikinMiniSplit local-HTTP protocol to a small
dependency-free CLI (Python 3 stdlib only). No cloud, no account: the
adapter exposes an unauthenticated HTTP GET API on port 80.

SAFETY
------
* The adapter's web server is single-threaded. Reads are retried with
  1s/2s/4s backoff; writes are never retried. Never poll faster than
  every 5-10 seconds.
* `/aircon/get_week_power` and `/aircon/get_year_power` CRASH the adapter
  (requires a breaker reset). This tool deliberately never calls them.
* Rapid OFF->ON toggling triggers a 3-minute compressor restart delay.

USAGE
-----
  daikin status                          # merged device state as JSON
  daikin set --power on --mode cool --temp 70 --fan auto --swing off
  daikin set --power off                 # off only; other params merged from device
  daikin get /aircon/get_control_info    # raw endpoint response
  daikin discover [PREFIX] [--json]      # subnet scan for adapters
  daikin schedule [--json]               # weekly schedule
  daikin scheduler --enable|--disable    # scheduler on/off
  daikin config show | daikin config set <ip>

Global options: --ip IP  --timeout SECONDS  --config PATH
"""

import argparse
import concurrent.futures
import ipaddress
import json
import os
import socket
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone

API_BASE_PATH = ""          # http://<ip>/  (port 80)
RETRY_DELAYS = (1.0, 2.0, 4.0)
DEFAULT_TIMEOUT = 10.0

# Mode wire codes for /aircon/get_control_info and set_control_info.
MODES = {
    "auto": "1", "dry": "2", "cool": "3", "heat": "4", "fan": "6",
}
MODE_FROM_CODE = {v: k for k, v in MODES.items()}
# Schedule API mode codes differ: 2=Dry 3=Cool 4=Heat 6=Fan, default Auto.
SCHEDULE_MODE_FROM_CODE = {"2": "dry", "3": "cool", "4": "heat", "6": "fan"}

FANS = {"auto": "A", "quiet": "B", "low": "3", "medium": "5", "high": "7"}
FAN_FROM_CODE = {v: k for k, v in FANS.items()}
FAN_ORDER = ["auto", "quiet", "low", "medium", "high"]

SWINGS = {"off": "0", "vertical": "1", "horizontal": "2", "both": "3"}
SWING_FROM_CODE = {v: k for k, v in SWINGS.items()}
SWING_ORDER = ["off", "vertical", "horizontal", "both"]

DAY_CODES = ["mo", "tu", "we", "th", "fr", "sa", "su"]
DAY_NAMES = {
    "mo": "Mon", "tu": "Tue", "we": "Wed", "th": "Thu",
    "fr": "Fri", "sa": "Sat", "su": "Sun",
}

HYSTERESIS = 1.0            # the unit applies an internal 1C offset in cool/heat
TEMP_MIN_C, TEMP_MAX_C = 18.0, 30.0


class DaikinError(Exception):
    pass


class OfflineError(DaikinError):
    pass


# ---------------------------------------------------------------------------
# Config
# ---------------------------------------------------------------------------

def config_path():
    return os.environ.get(
        "DAIKIN_CONFIG",
        os.path.expanduser("~/.config/daikin/config.json"),
    )


def load_config():
    path = config_path()
    try:
        with open(path) as f:
            data = json.load(f)
        ip = str(data.get("ip", "")).strip()
        return ip
    except FileNotFoundError:
        return ""
    except (ValueError, OSError):
        return ""


def save_config(ip):
    path = config_path()
    os.makedirs(os.path.dirname(path), exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump({"ip": ip}, f, indent=2)
        f.write("\n")
    os.replace(tmp, path)


def resolve_ip(args):
    ip = getattr(args, "ip", None) or load_config()
    if not ip:
        raise UsageConfigError(
            "no device IP configured. Run `daikin config set <ip>` or pass --ip."
        )
    return ip


class UsageConfigError(DaikinError):
    pass


# ---------------------------------------------------------------------------
# HTTP
# ---------------------------------------------------------------------------

def http_get(url, timeout=DEFAULT_TIMEOUT):
    req = urllib.request.Request(url, headers={"User-Agent": "daikin-cli/1.0"})
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        return resp.read().decode("utf-8", "replace")


def get_with_retry(base, path, timeout=DEFAULT_TIMEOUT, retries=RETRY_DELAYS):
    """GET a read endpoint with exponential backoff. Writes must NOT retry."""
    url = f"{base}{path}"
    last_err = None
    for attempt in range(len(retries) + 1):
        try:
            return http_get(url, timeout)
        except (urllib.error.URLError, socket.timeout, ConnectionError, OSError) as e:
            last_err = e
            if attempt < len(retries):
                time.sleep(retries[attempt])
    raise OfflineError(f"unreachable: {last_err}")


def parse_response(text):
    """`key=value` pairs separated by commas; values may be empty or '-'.

    Splits on the first '=' only, so URL-encoded values survive intact.
    """
    out = {}
    for pair in text.split(","):
        k, sep, v = pair.partition("=")
        if sep and k:
            out[k.strip()] = v.strip()
    return out


def as_float(value, default=None):
    if value is None:
        return default
    try:
        return float(value)
    except ValueError:
        return default


def as_int(value, default=0):
    f = as_float(value)
    return int(f) if f is not None else default


# ---------------------------------------------------------------------------
# Temperature helpers
# ---------------------------------------------------------------------------

def c2f(c):
    return c * 1.8 + 32.0


def f2c(f):
    return (f - 32.0) / 1.8


def round_half_c(c):
    return round(c * 2.0) / 2.0


def write_temp_c(display_c, mode):
    """Display temperature -> wire value, with hysteresis compensation."""
    t = display_c
    if mode == "heat":
        t += HYSTERESIS
    elif mode == "cool":
        t -= HYSTERESIS
    t = round_half_c(t)
    return max(TEMP_MIN_C, min(TEMP_MAX_C, t))


def display_temp_c(wire_c, mode):
    """Wire stemp -> displayed setpoint (hysteresis reversed)."""
    t = wire_c
    if mode == "heat":
        t -= HYSTERESIS
    elif mode == "cool":
        t += HYSTERESIS
    return round_half_c(t)


# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

def cmd_status(args):
    try:
        ip = resolve_ip(args)
    except UsageConfigError:
        # Widget-friendly: machine-readable on stdout (terminal users get the
        # same information via `daikin config show`).
        print(json.dumps({"online": False, "noConfig": True,
                          "error": "no adapter configured"}))
        return 3
    base = f"http://{ip}"

    def fetch(path):
        return get_with_retry(base, path, getattr(args, 'timeout', DEFAULT_TIMEOUT))

    with concurrent.futures.ThreadPoolExecutor(max_workers=3) as pool:
        futures = {
            pool.submit(fetch, p): p
            for p in (
                "/aircon/get_control_info",
                "/aircon/get_sensor_info",
                "/common/basic_info",
            )
        }
        results = {}
        for fut in concurrent.futures.as_completed(futures):
            path = futures[fut]
            try:
                results[path] = parse_response(fut.result())
            except OfflineError:
                results[path] = None

    control = results.get("/aircon/get_control_info")
    if control is None:
        print(json.dumps({"online": False, "ip": ip, "error": "adapter unreachable"}, indent=2))
        return 1

    sensor = results.get("/aircon/get_sensor_info") or {}
    basic = results.get("/common/basic_info") or {}

    mode = MODE_FROM_CODE.get(control.get("mode", "3"), "cool")
    wire_temp = as_float(control.get("stemp", "22"), 22.0)
    disp = display_temp_c(wire_temp, mode)

    state = {
        "online": True,
        "ip": ip,
        "power": control.get("pow", "0") == "1",
        "mode": mode,
        "stemp_c": disp,
        "stemp_f": round(c2f(disp), 1),
        "raw_stemp_c": round_half_c(wire_temp),
        "fan": FAN_FROM_CODE.get(control.get("f_rate", "A"), "auto"),
        "swing": SWING_FROM_CODE.get(control.get("f_dir", "0"), "off"),
        "humidity": sensor.get("hhum", "-"),
        "indoor_c": as_float(sensor.get("htemp")),
        "outdoor_c": as_float(sensor.get("otemp")),
        "compressor_hz": as_int(sensor.get("cmpfreq", "0")),
        "error_code": as_int(sensor.get("err", "0")),
        "alert": control.get("alert", "255"),
        "room": urllib.parse.unquote(basic.get("name", "")),
        "mac": basic.get("mac", ""),
        "firmware": basic.get("ver", "--").replace("_", "."),
        "led": basic.get("led", "-"),
        "ts": datetime.now(timezone.utc).astimezone().isoformat(timespec="seconds"),
    }
    if state["indoor_c"] is not None:
        state["indoor_f"] = round(c2f(state["indoor_c"]), 1)
    if state["outdoor_c"] is not None:
        state["outdoor_f"] = round(c2f(state["outdoor_c"]), 1)
    print(json.dumps(state, indent=2))
    return 0


def cmd_set(args):
    ip = resolve_ip(args)
    base = f"http://{ip}"

    current = parse_response(get_with_retry(base, "/aircon/get_control_info", getattr(args, 'timeout', DEFAULT_TIMEOUT)))
    mode = MODE_FROM_CODE.get(current.get("mode", "3"), "cool")
    wire = as_float(current.get("stemp", "22"), 22.0)
    disp = display_temp_c(wire, mode)

    if args.power is not None:
        power = args.power == "on"
    else:
        power = current.get("pow", "0") == "1"

    if args.mode is not None:
        mode = args.mode
    if args.fan is not None:
        fan = args.fan
    else:
        fan = FAN_FROM_CODE.get(current.get("f_rate", "A"), "auto")
    if args.swing is not None:
        swing = args.swing
    else:
        swing = SWING_FROM_CODE.get(current.get("f_dir", "0"), "off")

    if args.temp_f is not None:
        disp = round_half_c(f2c(args.temp_f))
        disp = max(TEMP_MIN_C, min(TEMP_MAX_C, disp))
    elif args.temp_c is not None:
        disp = round_half_c(args.temp_c)
        disp = max(TEMP_MIN_C, min(TEMP_MAX_C, disp))

    stemp = write_temp_c(disp, mode)

    query = (
        f"pow={1 if power else 0}"
        f"&mode={MODES[mode]}"
        f"&stemp={stemp:.1f}"
        f"&f_rate={FANS[fan]}"
        f"&f_dir={SWINGS[swing]}"
        f"&shum=0"
    )
    url = f"{base}/aircon/set_control_info?{query}"

    if args.dry_run:
        print(f"dry-run: GET {url}")
        return 0

    try:
        # Deliberate: no retry on writes (a retry could double-apply).
        http_get(url, getattr(args, 'timeout', DEFAULT_TIMEOUT))
    except (urllib.error.URLError, socket.timeout, ConnectionError, OSError) as e:
        raise OfflineError(f"write failed: {e}")

    print(json.dumps({
        "applied": True,
        "power": power, "mode": mode,
        "stemp_c": disp, "stemp_f": round(c2f(disp), 1),
        "wire_stemp_c": stemp,
        "fan": fan, "swing": swing,
        "query": query,
    }, indent=2))
    return 0


def cmd_get(args):
    ip = resolve_ip(args)
    base = f"http://{ip}"
    path = args.path if args.path.startswith("/") else "/" + args.path
    # Guardrail: the power-consumption endpoints brick the adapter.
    if path.split("?")[0] in ("/aircon/get_week_power", "/aircon/get_year_power"):
        print(f"refusing: {path} crashes the BRP072A43 web server", file=sys.stderr)
        return 2
    print(get_with_retry(base, path, getattr(args, 'timeout', DEFAULT_TIMEOUT)))
    return 0


def tcp_alive(ip, port=80, timeout=0.5):
    """Fast liveness check: a SYN to port 80. Dead hosts RST in ms."""
    try:
        s = socket.create_connection((ip, port), timeout=timeout)
        s.close()
        return True
    except (OSError, socket.timeout):
        return False


def scan_ip(ip, timeout):
    """Probe one address; return a basic_info dict if it is a Daikin adapter."""
    try:
        text = http_get(f"http://{ip}/common/basic_info", timeout)
    except Exception:
        return None
    data = parse_response(text)
    if data.get("ret") != "OK" or data.get("type") != "aircon":
        return None
    return {
        "ip": ip,
        "room": urllib.parse.unquote(data.get("name", "")),
        "mac": data.get("mac", ""),
        "firmware": data.get("ver", "--").replace("_", "."),
        "power": data.get("pow", "0") == "1",
    }


def local_subnet_prefix():
    """Best-effort local /24 prefix from the default route's source IP."""
    for target in ("8.8.8.8", "1.1.1.1"):
        try:
            s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            s.connect((target, 80))
            local = s.getsockname()[0]
            s.close()
            net = ipaddress.ip_network(f"{local}/24", strict=False)
            return str(net.network_address).rsplit(".", 1)[0]   # e.g. "192.168.1"
        except OSError:
            continue
    return None


def cmd_discover(args):
    prefix = args.prefix or local_subnet_prefix()
    if not prefix:
        raise UsageConfigError("no subnet prefix given and could not determine one")
    candidates = []
    net = ipaddress.ip_network(f"{prefix}.0/24", strict=False)
    for i in range(1, 255):
        candidates.append(f"{prefix}.{i}")

    # Phase 1: cheap liveness sweep. Dead hosts RST in milliseconds, so this
    # is fast and never hammers any live device's HTTP server.
    live = []
    with concurrent.futures.ThreadPoolExecutor(max_workers=args.workers) as pool:
        futures = {pool.submit(tcp_alive, ip): ip for ip in candidates}
        for fut in concurrent.futures.as_completed(futures):
            if fut.result():
                live.append(futures[fut])

    # Phase 2: gentle HTTP probe, only against the handful of live hosts.
    # Serial here on purpose: the BRP072A43 web server is single-threaded and
    # a burst of parallel HTTP requests stalls it (see README safety notes).
    found = []
    for ip in sorted(live):
        res = scan_ip(ip, max(getattr(args, 'timeout', DEFAULT_TIMEOUT), 2.5))
        if res:
            found.append(res)

    found.sort(key=lambda d: d["ip"])
    if args.json:
        print(json.dumps(found, indent=2))
    else:
        if not found:
            print(f"no Daikin adapters found on {prefix}.0/24 ({len(live)} live host(s))")
        for d in found:
            state = "on " if d["power"] else "off"
            print(f"{d['ip']}  {state}  {d['room'] or '(no name)'}  {d['mac']}  fw {d['firmware']}")
        if found:
            print(f"\n{len(found)} adapter(s) found. Save one with: daikin config set <ip>")
    return 0


def cmd_schedule(args):
    ip = resolve_ip(args)
    base = f"http://{ip}"
    info = parse_response(get_with_retry(base, "/aircon/get_scdltimer_info", getattr(args, 'timeout', DEFAULT_TIMEOUT)))
    data = parse_response(get_with_retry(base, "/aircon/get_scdltimer", getattr(args, 'timeout', DEFAULT_TIMEOUT)))

    enabled = info.get("en_scdltimer", "0") == "1"
    active = as_int(info.get("active_no", "1"), 1)
    names = [info.get(f"scdl{i}_name", "") for i in (1, 2, 3)]

    days = []
    for code in DAY_CODES:
        count = as_int(data.get(f"{code}c", "0"))
        events = []
        for i in range(1, count + 1):
            p = f"{code}{i}_"
            tmp = data.get(f"{p}tmp", "--")
            temp_c = as_float(tmp) if tmp not in ("--", "") else None
            minutes = as_int(data.get(f"{p}time", "0"))
            events.append({
                "enabled": data.get(f"{p}en", "0") == "1",
                "power": data.get(f"{p}pow", "0") == "1",
                "mode": SCHEDULE_MODE_FROM_CODE.get(data.get(f"{p}mod", "1"), "auto"),
                "temp_c": temp_c,
                "time": f"{minutes // 60:02d}:{minutes % 60:02d}",
            })
        days.append({"day": DAY_NAMES[code], "events": events})

    if args.json:
        print(json.dumps({
            "enabled": enabled, "active": active, "names": names, "days": days,
        }, indent=2))
        return 0

    state = "on" if enabled else "off"
    print(f"Scheduler: {state}  (active slot {active})")
    for i, name in enumerate(names, 1):
        if name:
            print(f"  slot {i}: {name}")
    for day in days:
        if not day["events"]:
            continue
        parts = []
        for e in day["events"]:
            if not e["enabled"]:
                continue
            verb = "on " if e["power"] else "off"
            if e["power"] and e["temp_c"] is not None:
                parts.append(f"{e['time']} {verb}{e['mode']} {round(c2f(e['temp_c']))}F")
            elif e["power"]:
                parts.append(f"{e['time']} on {e['mode']}")
            else:
                parts.append(f"{e['time']} off")
        if parts:
            print(f"  {day['day']}: " + ",  ".join(parts))
    return 0


def cmd_scheduler(args):
    ip = resolve_ip(args)
    base = f"http://{ip}"
    value = "1" if args.enable else "0"
    try:
        # No retry: this is a write.
        http_get(f"{base}/aircon/set_scdltimer_info?en_scdltimer={value}", getattr(args, 'timeout', DEFAULT_TIMEOUT))
    except (urllib.error.URLError, socket.timeout, ConnectionError, OSError) as e:
        raise OfflineError(f"write failed: {e}")
    print(json.dumps({"scheduler": "enabled" if args.enable else "disabled"}, indent=2))
    return 0


def cmd_config(args):
    if args.config_cmd == "show":
        path = config_path()
        ip = load_config()
        if not ip:
            print(f"no config at {path}")
            return 2
        print(json.dumps({"ip": ip, "config": path}, indent=2))
        return 0
    if args.config_cmd == "set":
        ipaddress.ip_address(args.config_ip)  # validates
        save_config(args.config_ip)
        print(json.dumps({"ip": args.config_ip, "config": config_path()}, indent=2))
        return 0
    return 2


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def build_parser():
    # Global options may appear before or after the subcommand
    # (rightmost occurrence wins). SUPPRESS keeps an absent value from
    # clobbering the other level, so both positions work on any Python.
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--ip", default=argparse.SUPPRESS,
                        help="adapter IP (overrides config)")
    common.add_argument("--timeout", type=float, default=argparse.SUPPRESS,
                        help=f"per-request timeout in seconds (default {DEFAULT_TIMEOUT:g})")
    common.add_argument("--config", default=argparse.SUPPRESS,
                        help="config file path (default ~/.config/daikin/config.json)")

    p = argparse.ArgumentParser(
        prog="daikin",
        description="Daikin BRP072A43 mini-split controller (local HTTP API)",
        parents=[common],
    )

    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("status", parents=[common], help="merged device state as JSON")

    s = sub.add_parser("set", parents=[common],
                       help="apply settings (merged with current device state)")
    s.add_argument("--power", choices=["on", "off"], help="power state")
    s.add_argument("--mode", choices=sorted(MODES), help="operating mode")
    tgroup = s.add_mutually_exclusive_group()
    tgroup.add_argument("--temp", dest="temp_f", type=float, metavar="FAH",
                        help="setpoint in Fahrenheit (rounded to 0.5C on the wire)")
    tgroup.add_argument("--temp-c", dest="temp_c", type=float, metavar="CEL",
                        help="setpoint in Celsius (0.5 increments)")
    s.add_argument("--fan", choices=FAN_ORDER, help="fan speed")
    s.add_argument("--swing", choices=SWING_ORDER, help="swing direction")
    s.add_argument("--dry-run", action="store_true", help="print the request instead of sending")

    g = sub.add_parser("get", parents=[common], help="raw endpoint response")
    g.add_argument("path", help="e.g. /aircon/get_control_info")

    d = sub.add_parser("discover", parents=[common], help="scan a subnet for adapters")
    d.add_argument("prefix", nargs="?", help="subnet prefix, e.g. 192.168.1 (default: local)")
    d.add_argument("--workers", type=int, default=48)
    d.add_argument("--json", action="store_true")

    sc = sub.add_parser("schedule", parents=[common], help="show the weekly schedule")
    sc.add_argument("--json", action="store_true")

    sh = sub.add_parser("scheduler", parents=[common], help="enable/disable the scheduler")
    g2 = sh.add_mutually_exclusive_group(required=True)
    g2.add_argument("--enable", action="store_true")
    g2.add_argument("--disable", action="store_true")

    c = sub.add_parser("config", parents=[common], help="show or set the device IP")
    csub = c.add_subparsers(dest="config_cmd", required=True)
    csub.add_parser("show", parents=[common])
    cset = csub.add_parser("set", parents=[common])
    cset.add_argument("config_ip")

    return p


def main(argv=None):
    args = build_parser().parse_args(argv)
    cfg = getattr(args, 'config', None)
    if cfg:
        os.environ["DAIKIN_CONFIG"] = cfg

    try:
        if args.command == "status":
            return cmd_status(args)
        if args.command == "set":
            return cmd_set(args)
        if args.command == "get":
            return cmd_get(args)
        if args.command == "discover":
            return cmd_discover(args)
        if args.command == "schedule":
            return cmd_schedule(args)
        if args.command == "scheduler":
            return cmd_scheduler(args)
        if args.command == "config":
            return cmd_config(args)
    except UsageConfigError as e:
        print(f"error: {e}", file=sys.stderr)
        return 3
    except OfflineError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130
    return 2


if __name__ == "__main__":
    sys.exit(main())